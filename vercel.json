{
  "outputDirectory": "dist",
  "functions": {
  "api/*.js": {
    "maxDuration": 60
  },
  "api/youtube/*.js": {
    "maxDuration": 25
  }
}
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
